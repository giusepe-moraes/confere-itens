{
  "manifest_version": 3,
  "name": "Confere Itens – conferência de itens para o Compras.gov (não oficial)",
  "short_name": "Confere Itens",
  "version": "0.2",
  "minimum_chrome_version": "111",
  "description": "Confere os itens da página de resumo da contratação do Compras.gov com a planilha. Não oficial; só observa o site, sem requisições.",
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://cnetmobile.estaleiro.serpro.gov.br/comprasnet-artefatos-web/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://cnetmobile.estaleiro.serpro.gov.br/comprasnet-artefatos-web/*"],
      "js": ["verificacao.js", "painel.js"],
      "run_at": "document_start"
    }
  ]
}
